{
  "name": "ecommerce-app-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "node demo-api/server.js",
    "demo": "node demo-api/server.js & ng serve --port 4200",
    "api:health": "node -e \"require('http').get('http://localhost:3333/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e);process.exit(1)})\""
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.6.0",
    "@angular/animations": "21.2.18",
    "@angular/cdk": "21.2.14",
