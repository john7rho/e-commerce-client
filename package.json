{
  "name": "ecommerce-app-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "node demo-api/server.js",
    "demo": "node demo-api/server.js & ng serve --port 4200",
    "api:health": "node -e \"require('http').get('http://localhost:3333/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e);process.exit(1)})\""
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.0.0",
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/material": "^15.2.9",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@auth0/angular-jwt": "^5.0.2",
    "@microsoft/signalr": "^6.0.8",
    "alertifyjs": "^1.13.1",
    "bootstrap": "^5.1.3",
    "jquery": "^3.6.0",
    "ngx-file-drop": "^13.0.0",
    "ngx-spinner": "^15.0.1",
    "ngx-toastr": "^15.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "^0.12.0"
  },
